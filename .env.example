# DropMail Environment Variables Configuration
# Copy this file to .env for local development

# Application Branding
VITE_APP_NAME="DropMail"

# Email Provider Service Adapter (default: mailtm)
VITE_API_PROVIDER="mailtm"

# Client Polling Interval in seconds (default: 10s, recommended minimum 6s to respect provider limits)
VITE_POLL_INTERVAL_SECONDS=10

# Maximum auto-retry attempts on network interruption
VITE_MAX_POLL_RETRIES=5

# Optional: Custom Mail.tm API Base URL if self-hosting or mirroring
MAILTM_BASE_URL="https://api.mail.tm"
